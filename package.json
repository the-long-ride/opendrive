{
  "name": "opendrive-workspace",
  "author": "the-long-ride",
  "private": true,
  "type": "module",
  "scripts": {
    "desktop": "node scripts/launch-desktop.mjs",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all -- --check",
    "lint": "npm run lint:source && npm run lint:loc && npm run lint:dead && npm run lint:rust",
    "lint:source": "node scripts/lint.mjs",
    "lint:loc": "node scripts/loc-lint.mjs",
    "lint:dead": "knip",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "test:coverage:node": "node scripts/test-coverage-node.mjs",
    "test:coverage:rust": "node scripts/test-coverage-rust.mjs",
    "test:coverage": "npm run test:coverage:node && npm run test:coverage:rust",
    "test:gate": "npm run format:check && npm run lint && npm run test:scripts && npm run test:coverage"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "c8": "^12.0.0",
    "knip": "^6.45.1",
    "prettier": "^3.10.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
